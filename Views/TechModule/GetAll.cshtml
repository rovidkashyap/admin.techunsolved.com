@model IEnumerable<admin.techunsolved.com.Models.TechModuleModel>

<!-- Search Input -->
<div class="mb-3">
    <input type="text" id="categoryFilter" class="form-control" placeholder="Search by Modules Name">
</div>

<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Modules</h5>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th style="text-align:center;"></th>
                        <th><b>@Html.DisplayNameFor(model => model.TechModulesName)</b></th>
                        <th><b>@Html.DisplayNameFor(model => model.Description)</b></th>
                        <th><b>@Html.DisplayNameFor(model => model.Initial)</b></th>
                        <th><b>@Html.DisplayNameFor(model => model.TechSubCategoryName)</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align:center;">
                                <span class="badge bg-label-info me-1">
                                    <a href="@Url.Action("Edit", new { id = item.TechModulesId })">
                                        EDIT
                                    </a>
                                </span>
                            </td>
                            <td><b>@Html.DisplayFor(modelItem => item.TechModulesName)</b></td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td>@Html.DisplayFor(modelItem => item.Initial)</td>
                            <td>@Html.DisplayFor(modelItem => item.TechSubCategoryName)</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
<!--/ Basic Bootstrap Table -->
