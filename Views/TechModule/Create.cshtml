@model admin.techunsolved.com.Models.TechModuleModel

<div class="col-xxl">
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Create Tech Modules</h5> <small class="text-muted float-end">Merged input group</small>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="row mb-3">
                    <label asp-for="TechSubCategoryName" for="exampleFormControlSelect1" class="col-sm-2 col-form-label">Category Name</label>
                    <div class="col-sm-10">
                        <select asp-for="TechSubCategoryId" asp-items="@(new SelectList(@ViewBag.SubCategoryNames, "TechSubcategoryId", "TechSubcategoryName"))" class="form-select" id="exampleFormControlSelect1" aria-label="Select Category Name">
                            <option selected>Select SubCategory Name</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="TechModulesName" class="col-sm-2 col-form-label" for="basic-icon-default-company">Module Name</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-company2" class="input-group-text"><i class="bx bx-buildings"></i></span>
                            <input asp-for="TechModulesName" type="text" id="basic-icon-default-company" class="form-control" placeholder="Enter Module name.." aria-label="Enter Category name.." aria-describedby="basic-icon-default-company2" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Initial" class="col-sm-2 col-form-label" for="basic-icon-default-company">Initial</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-company2" class="input-group-text"><i class="bx bx-buildings"></i></span>
                            <input asp-for="Initial" type="text" id="basic-icon-default-company" class="form-control" placeholder="Enter initial..." aria-label="Enter initial..." aria-describedby="basic-icon-default-company2" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Description" class="col-sm-2 form-label" for="basic-icon-default-message">Description</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-message2" class="input-group-text"><i class="bx bx-comment"></i></span>
                            <textarea asp-for="Description" id="basic-icon-default-message" class="form-control" placeholder="Hi, Do you like to enter some description?" aria-label="Hi, Do you have a moment to talk Joe?" aria-describedby="basic-icon-default-message2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

