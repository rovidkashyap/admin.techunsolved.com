@model admin.techunsolved.com.Models.TechModuleModel

<div class="col-xxl">
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Edit Articles</h5> <small class="text-muted float-end">Merged input groups</small>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div class="row mb-3">
                    <!-- This div contains the hidden input for TechArticleId -->
                    <div class="d-none">
                        <input asp-for="TechModulesId" class="form-control" />
                    </div>
                </div>
                <!-- Topic ID & Name -->
                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Topic Name</label>
                    <div class="col-sm-10">
                        <select id="topicName" class="form-select" disabled>
                            <option value="techTopicName">@ViewBag.TopicName</option>
                            <input asp-for="TechSubCategoryId" type="hidden" />
                        </select>
                    </div>
                </div>
                <!-- Tech Modules & Topics -->
                <!-- Main Heading & Sub  Heading -->
                <div class="row mb-3">
                    <label asp-for="TechModulesName " class="col-sm-2 col-form-label" for="basic-icon-default-company">Module Name</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-company2" class="input-group-text"><i class="bx bx-buildings"></i></span>
                            <input asp-for="TechModulesName" type="text" id="basic-icon-default-company" class="form-control"
                                   placeholder="Enter Module name.." aria-label="Enter Module name.." aria-describedby="basic-icon-default-company2" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Initial" class="col-sm-2 col-form-label" for="basic-icon-default-company">Initial</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-company2" class="input-group-text"><i class="bx bx-buildings"></i></span>
                            <input asp-for="Initial" type="text" id="basic-icon-default-company" class="form-control"
                                   placeholder="Enter Initial.." aria-label="Enter Initial.." aria-describedby="basic-icon-default-company2" />
                        </div>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <label asp-for="Description" class="col-sm-2 form-label" for="basic-icon-default-message">Description</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-message2" class="input-group-text"><i class="bx bx-comment"></i></span>
                            <textarea asp-for="Description" id="basic-icon-default-message" class="form-control"
                                      placeholder="Hi, Do you like to enter some Description?"
                                      aria-label="Hi, Do you like to enter some Description?"
                                      aria-describedby="basic-icon-default-message2">
                        </textarea>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
