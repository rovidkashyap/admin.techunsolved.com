@model IEnumerable<admin.techunsolved.com.Models.TechTopicModel>

<!-- Search Input -->
<div class="mb-3">
    <input type="text" id="categoryFilter" class="form-control" placeholder="Search by Topic Name">
</div>

<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Topics</h5>
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th style="text-align:center;"></th>
                        <th><b>@Html.DisplayNameFor(model => model.TechTopicName)</b></th>
                        <th><b>@Html.DisplayNameFor(model => model.Level)</b></th>
                        <th><b>@Html.DisplayNameFor(model => model.TechModulesName)</b></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align:center;">
                                <span class="badge bg-label-info me-1">
                                    <a href="@Url.Action("Edit", new { id = item.TechTopicId })">
                                        EDIT
                                    </a>
                                </span>
                            </td>
                            <td><b>@Html.DisplayFor(modelItem => item.TechTopicName)</b></td>
                            <td>@Html.DisplayFor(modelItem => item.Level)</td>
                            <td>@Html.DisplayFor(modelItem => item.TechModulesName)</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
        <div class="demo-inline-spacing">
            <!-- Basic Pagination -->
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link "href="@Url.Action("GetAll", new { page = ViewBag.CurrentPage - 1 })" aria-label="Previous">
                                <span area-hidden="true">&laquo;</span>
                                <span class="sr-only">Prev</span>
                            </a>
                        </li>
                    }
                    @for (int i = ViewBag.StartPage; i <= ViewBag.EndPage; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("GetAll", new { page = i })">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item"> 
                            <a class="page-link" href="@Url.Action("GetAll", new { page = ViewBag.CurrentPage + 1 })" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                                <span class="sr-only">Next</span>
                            </a>
                        </li>
                    }

                </ul>
            </nav>
            <!--/ Basic Pagination -->
        </div>
    </div>
</div>
<!--/ Basic Bootstrap Table -->
