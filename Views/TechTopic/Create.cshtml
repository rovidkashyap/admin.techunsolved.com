@model admin.techunsolved.com.Models.TechTopicModel

<div class="col-xxl">
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Create Tech Topics</h5> <small class="text-muted float-end">Merged input group</small>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="row mb-3">
                    <label asp-for="TechModulesName" for="exampleFormControlSelect1" class="col-sm-2 col-form-label">Category Name</label>
                    <div class="col-sm-10">
                        <select asp-for="TechModulesId" asp-items="@(new SelectList(@ViewBag.ModuleNames, "TechModulesId", "TechModulesName"))" class="form-select" id="exampleFormControlSelect1" aria-label="Select Category Name">
                            <option selected>Select SubCategory Name</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="TechTopicName" class="col-sm-2 col-form-label" for="basic-icon-default-company">Topic Name</label>
                    <div class="col-sm-10">
                        <div class="input-group input-group-merge">
                            <span id="basic-icon-default-company2" class="input-group-text"><i class="bx bx-buildings"></i></span>
                            <input asp-for="TechTopicName" type="text" id="basic-icon-default-company" class="form-control" placeholder="Enter Topic name.." aria-label="Enter Topic name.." aria-describedby="basic-icon-default-company2" />
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Level" for="exampleFormControlSelect1" class="col-sm-2 col-form-label">Topic Level</label>
                    <div class="col-sm-10">
                        <select asp-for="Level" class="form-select" id="exampleFormControlSelect1" aria-label="Select Topic Level">
                            <option selected>Select Topic Level</option>
                            <option value="Beginners">Beginners</option>
                            <option value="Medium">Medium</option>
                            <option value="Advance">Advance</option>
                        </select>
                    </div>
                </div>
                
                <div class="row justify-content-end">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

