@model IEnumerable<admin.techunsolved.com.Models.TechTopicModel>

<div class="mb-3">
    <label for="moduleId" class="form-label">Select Programming</label>
    <select id="moduleId" class="form-select">
        <option value="">Select Module</option>
    </select>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>@Html.DisplayName("Topic")</th>
                        <th>@Html.DisplayNameFor(model => model.TechTopicName)</th>
                        <th>@Html.DisplayNameFor(model => model.TechModulesName)</th>
                        <th>@Html.DisplayNameFor(model => model.Level)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-medium">@counter</span></td>
                            <td>@Html.DisplayFor(modelItem => item.TechTopicName)</td>
                            <td>@Html.DisplayFor(modelItem => item.TechModulesName)</td>
                            <td>
                                @if (item.Level == "Beginners")
                                {
                                    <span class="badge bg-label-primary me-1">
                                        @Html.DisplayFor(modelItem => item.Level)
                                    </span>
                                }
                                else if (item.Level == "Medium")
                                {
                                    <span class="badge bg-label-success me-1">
                                        @Html.DisplayFor(modelItem => item.Level)
                                    </span>
                                }
                                else if (item.Level == "Advance")
                                {
                                    <span class="badge bg-label-warning me-1">
                                        @Html.DisplayFor(modelItem => item.Level)
                                    </span>
                                }
                                else
                                {
                                    @item.Level
                                }
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="bx bx-dots-vertical-rounded"></i></button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="@Url.Action("Edit", new { id = item.TechTopicId })"><i class="bx bx-edit-alt me-1"> Edit</i></a>
                                        <a class="dropdown-item" href="javascript:void(0);" onclick="deleteRecord(@item.TechTopicId)"><i class="bx bx-trash me-1"></i> Delete</a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
